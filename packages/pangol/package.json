{
  "name": "pangol",
  "version": "0.1.0-alpha.0",
  "description": "The TypeScript backend framework you can let AI write. Vulnerabilities become build errors.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/pangoljs/pangol.git", "directory": "packages/pangol" },
  "homepage": "https://github.com/pangoljs/pangol",
  "keywords": ["backend", "framework", "typescript", "security", "api", "ai"],
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./bun": { "types": "./dist/bun.d.ts", "default": "./dist/bun.js" },
    "./node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" },
    "./register": { "types": "./dist/register.d.ts", "default": "./dist/register.js" }
  },
  "bin": { "pangol": "dist/cli/main.js" },
  "files": ["dist", "src", "CHANGELOG.md"],
  "sideEffects": ["./dist/register.js", "./dist/cli/main.js"],
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:bun": "PANGOL_TEST_RUNTIME=bun bun --bun ./node_modules/vitest/vitest.mjs run",
    "typeperf": "bun scripts/type-performance.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "publishConfig": { "access": "public", "tag": "alpha" },
  "peerDependencies": { "typescript": ">=5.0" },
  "peerDependenciesMeta": { "typescript": { "optional": true } },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
